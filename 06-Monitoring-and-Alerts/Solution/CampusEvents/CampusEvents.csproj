<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CampusEvents</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="3.2.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../../CampusEvents/Data/*.cs" Link="Data/%(Filename)%(Extension)" />
    <Compile Include="../../../CampusEvents/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../../../CampusEvents/Services/*.cs" Link="Services/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
